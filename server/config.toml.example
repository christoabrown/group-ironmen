# Optional. Every setting can also be given as an environment variable (shown
# after each key), which takes precedence over this file. The Docker image only
# uses environment variables.

# PostgreSQL (PG_USER, PG_PASSWORD, PG_HOST, PG_PORT, PG_DB, PG_POOL_MAX_SIZE)
[pg]
user = "postgres"
password = "postgres"
host = "localhost"
port = 5432
dbname = "osrs_tracker"
pool.max_size = 16

[logger]
level = "Info"  # Info, Warn or Error

[server]
secure_cookies = true   # COOKIE_SECURE; set to false for plain-HTTP local development

# The Discord application people log in with (required). Discord says who
# someone is; the hub says whether they are a member and an admin.
# (DISCORD_CLIENT_ID, DISCORD_CLIENT_SECRET, DISCORD_REDIRECT_URI)
[discord]
client_id = ""
client_secret = ""
redirect_uri = "http://localhost:4000/login/discord"
# Development only: a stand-in for Discord, such as the mock hub's
# (DISCORD_API_BASE, DISCORD_AUTHORIZE_URL). Whoever answers there decides
# who logs in.
# api_base = "http://localhost:7070/discord"

# osrs-data-hub, where every player's data comes from and which says who may
# log in (required; a service key).
# (HUB_BASE_URL, HUB_API_KEY, HUB_POLL_INTERVAL_SECS, HUB_HISTORY_ENABLED,
# HUB_REQUEST_BUDGET, HUB_EVENTS_POLL_SECS, HUB_FULL_REFRESH_SECS, HUB_TIMEOUT_SECS)
[hub]
base_url = "http://localhost:3000"
api_key = ""
