# Optional. Every setting can also be given as an environment variable (shown
# after each key), which takes precedence over this file. The Docker image only
# uses environment variables.

# PostgreSQL (PG_USER, PG_PASSWORD, PG_HOST, PG_PORT, PG_DB, PG_POOL_MAX_SIZE)
[pg]
user = "postgres"
password = "postgres"
host = "localhost"
port = 5432
dbname = "osrs_tracker"
pool.max_size = 16

[logger]
level = "Info"  # Info, Warn or Error

[server]
secure_cookies = true   # COOKIE_SECURE; set to false for plain-HTTP local development
# setup_token = ""      # SETUP_TOKEN; when set, creating the first admin asks for it

# Discord OAuth (DISCORD_CLIENT_ID enables it; DISCORD_CLIENT_SECRET,
# DISCORD_REDIRECT_URI, DISCORD_AUTO_REGISTRATION, DISCORD_AUTOREG_SERVERS)
[discord]
enabled = false
client_id = ""
client_secret = ""
redirect_uri = "http://localhost:4000/login/discord"
auto_registration = false
autoreg_servers = []

# osrs-data-hub, where every player's data comes from (required).
# (HUB_BASE_URL, HUB_API_KEY, HUB_POLL_INTERVAL_SECS, HUB_HISTORY_ENABLED,
# HUB_REQUEST_BUDGET, HUB_EVENTS_POLL_SECS, HUB_FULL_REFRESH_SECS, HUB_TIMEOUT_SECS)
[hub]
base_url = "http://localhost:3000"
api_key = ""
