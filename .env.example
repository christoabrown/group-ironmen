### Frontend settings
HOST_URL=http://osrs_tracker_backend:8080 # URL of the backend as seen from the frontend container (the frontend proxies /api to it).
SITE_TITLE=OSRS Guild Map # Browser tab title.
SITE_NAME=OSRS Guild Map # Name shown on the homepage and navigation.
# ICONS_BASE_URL=https://icons.scapekeeper.com # Where item, skill and slot icons load from (osrs-icons). Set it empty to turn icons off, or to your own mirror.

### Backend settings
PG_USER=postgres # Any value when using the bundled postgres; otherwise match your external database.
PG_PASSWORD=postgres
PG_HOST=postgres # Only change this when using an external database.
PG_PORT=5432
PG_DB=osrs_tracker
# PG_POOL_MAX_SIZE=16
COOKIE_SECURE=true # Set to false only when serving the site over plain HTTP (local development).

### osrs-data-hub (required) — every player's data comes from the hub, and the hub says who may log in.
HUB_BASE_URL=https://hub.example.com # Base URL of the hub, without /api/v1.
HUB_API_KEY=ohub_xxxxxxxxxx_xxxxxxxx # An integration (service) key from the hub admin. With a personal key nobody can log in.
# HUB_POLL_INTERVAL_SECS=5             # How often to poll /api/v1/snapshot (minimum 2).
# HUB_FULL_REFRESH_SECS=120            # How often the snapshot is read in full instead of only what changed.
# HUB_EVENTS_POLL_SECS=5               # How often the hub's events feed is read.
# HUB_TIMEOUT_SECS=10                  # How long a hub request may take.
# HUB_REQUEST_BUDGET=                  # Hub requests per minute this server allows itself (default: 80 % of the key's limit).
# HUB_HISTORY_ENABLED=true             # Serve XP graphs, location trails and the events feed from the hub.
# RUST_LOG=info                        # Log level of the backend.

### Discord (required) — the application people log in with. Discord says who someone is; the hub says whether they are a member and an admin.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:4000/login/discord # Must match a redirect registered in the Discord application (points to the frontend).
# DISCORD_API_BASE=http://localhost:7070/discord # Development only: the mock hub's stand-in for Discord. Whoever answers there decides who logs in.
