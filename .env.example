### Frontend settings
HOST_URL=http://osrs_tracker_backend:8080 # URL of the backend as seen from the frontend container (the frontend proxies /api to it).
SITE_TITLE=OSRS Guild Map # Browser tab title.
SITE_NAME=OSRS Guild Map # Name shown on the homepage and navigation.
# ICONS_BASE_URL=https://icons.scapekeeper.com # Where item, skill and slot icons load from (osrs-icons). Set it empty to turn icons off, or to your own mirror.

### Backend settings
PG_USER=postgres # Any value when using the bundled postgres; otherwise match your external database.
PG_PASSWORD=postgres
PG_HOST=postgres # Only change this when using an external database.
PG_PORT=5432
PG_DB=osrs_tracker
# PG_POOL_MAX_SIZE=16
COOKIE_SECURE=true # Set to false only when serving the site over plain HTTP (local development).
# SETUP_TOKEN= # When set, creating the first admin asks for this value (the setup page shows a field for it). Use a long random value, e.g. `openssl rand -hex 32`, on any site that is public before the admin exists.

### osrs-data-hub (required) — every player's data comes from the hub.
HUB_BASE_URL=https://hub.example.com # Base URL of the hub, without /api/v1.
HUB_API_KEY=ohub_xxxxxxxxxx_xxxxxxxx # An integration (service) key from the hub admin, or a personal key.
# HUB_POLL_INTERVAL_SECS=5             # How often to poll /api/v1/snapshot (minimum 2).
# HUB_HISTORY_ENABLED=true             # Serve XP graphs, location trails and the events feed from the hub.

### Discord OAuth (optional) — leave DISCORD_CLIENT_ID unset to disable.
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# DISCORD_REDIRECT_URI=http://localhost:4000/login/discord # Must match the redirect URI registered in your Discord app (points to the frontend).
# DISCORD_AUTO_REGISTRATION=false # Allow members of DISCORD_AUTOREG_SERVERS to create an account by logging in.
# DISCORD_AUTOREG_SERVERS=        # Comma-separated Discord server (guild) IDs. Linked users must stay in one of them.
